<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KASA" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Prevent Xiaomi MIUI / HyperOS from forcefully distorting custom colors in Dark Mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Full edge-to-edge support around camera punch-holes (Samsung & Xiaomi AMOLED screens) -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
